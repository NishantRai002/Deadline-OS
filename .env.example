# ── Copy this file to .env and fill in your values ──
# .env is listed in .gitignore — NEVER commit real secrets

FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development

# Azure SQL Database connection string
AZURE_SQL_CONN=Driver={ODBC Driver 18 for SQL Server};Server=YOUR_SERVER.database.windows.net;Database=deadlineos;UID=YOUR_USER;PWD=YOUR_PASSWORD;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Azure Blob Storage
AZURE_STORAGE_CONN_STR=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=attachments
